Table users {
  uid varchar [pk, not null, note: 'Document ID = Firebase Auth UID']
  email varchar [not null]
  fullName varchar [not null]
  avatar text
  joinDate timestamp [not null]
  personalStreak int [not null]
  lastStreakDate varchar [note: 'YYYY-MM-DD (UTC)']
  birthday varchar [note: 'yyyy-MM-dd']
  inviteCode varchar
  inviteCodeExpiresAt timestamp
  unlockedFrames jsonb [not null, note: 'string[] of frames.frameId']
  fcmTokens jsonb [not null, note: 'string[]']
  astrite int [not null, note: 'Must match sum(astriteTransactions.amount)']
  unlockedSkins jsonb [not null, note: 'number[] matching APK SkinRegistry']
  unlockedEffects jsonb [not null, note: 'number[] matching APK TouchEffectRegistry']
  signupBonusClaimed boolean [not null]
  gachaPity jsonb [note: 'Discovered in live Firestore (not in TS entity) · [firestore-only]']
  avatarUrl varchar [note: 'Discovered in live Firestore (not in TS entity) · [firestore-only]']
  name varchar [note: 'Discovered in live Firestore (not in TS entity) · [firestore-only]']
  username varchar [note: 'Discovered in live Firestore (not in TS entity) · [firestore-only]']
  Note: 'Firestore path: users (code+firestore, sampled 5 docs). Firebase Auth UID is the document ID. Holds profile, streaks, unlocked items, and Astrite wallet.'
}

Table friendships {
  pairId varchar [pk, not null, note: 'Document ID = sorted uid1_uid2']
  userIds jsonb [not null, note: 'Sorted [uidA, uidB] for array-contains queries']
  user1Id varchar [not null]
  user2Id varchar [not null]
  friendStreak int [not null]
  lastInteractionAt timestamp
  status friendships_status [not null]
  requesterUid varchar [note: 'User who clicked invite link']
  createdAt timestamp [not null]
  Note: 'Firestore path: friendships (code+firestore, sampled 4 docs). Friend relationship & shared streak between two users.'
}

Table posts {
  momentId varchar [pk, not null, note: 'Document ID']
  userId varchar [not null]
  contentType posts_content_type [not null]
  mediaUrl text [not null]
  frameId varchar
  caption text
  coopUserId varchar [note: 'Partner UID for co-op moment']
  postTime timestamp [not null]
  clientRequestId varchar [note: 'Idempotency key from client']
  Note: 'Firestore path: posts (code+firestore, sampled 50 docs). Moments (photo/GIF posts). Subcollections: views, reactions.'
}

Table posts_views {
  momentId varchar [not null, note: 'Parent document ID (posts/{momentId}/views)']
  viewerId varchar [pk, not null, note: 'Document ID = viewer UID']
  isSeen boolean [not null]
  seenAt timestamp [not null]
  Note: 'Firestore path: posts/{momentId}/views (code+firestore, sampled 77 docs). Subcollection of posts tracking which users viewed a moment.'
}

Table posts_reactions {
  momentId varchar [not null, note: 'Parent document ID (posts/{momentId}/reactions)']
  reactionId varchar [pk, not null, note: 'Document ID']
  reactorId varchar [not null]
  emojiType varchar [not null]
  createdAt timestamp [not null]
  Note: 'Firestore path: posts/{momentId}/reactions (code+firestore, sampled 27 docs). Subcollection of posts storing emoji reactions on a moment.'
}

Table coopInvites {
  inviteId varchar [pk, not null, note: 'Document ID']
  inviterId varchar [not null]
  inviteeId varchar [not null]
  inviterMediaUrl text
  inviteeMediaUrl text
  mergedMediaUrl text
  status coop_invites_status [not null]
  createdAt timestamp [not null]
  respondedAt timestamp
  momentId varchar [note: 'Legacy field']
  Note: 'Firestore path: coopInvites (code+firestore, sampled 8 docs). Co-op dual-camera capture invitations (5-minute TTL).'
}

Table messages {
  messageId varchar [pk, not null, note: 'Document ID']
  senderId varchar [not null]
  receiverId varchar [note: 'Set for 1-1 chat']
  groupId varchar [note: 'Set for group chat']
  messageType messages_message_type [not null]
  content text [not null]
  sendTime timestamp [not null]
  isSeen boolean [not null]
  attachmentUrl text
  attachmentType messages_attachment_type
  reactions jsonb [note: 'Map<uid, emoji>']
  replyToId varchar
  replyToType messages_reply_to_type
  replyToContent text
  replyToSenderId varchar
  Note: 'Firestore path: messages (code+firestore, sampled 50 docs). 1-to-1 (receiverId) or group (groupId) messages with optional reply snapshot.'
}

Table chatGroups {
  groupId varchar [pk, not null, note: 'Document ID']
  groupName varchar [not null]
  avatar text
  memberIds jsonb [not null, note: 'string[] of users.uid']
  createdBy varchar [not null]
  createdAt timestamp [not null]
  mutedBy jsonb [note: 'string[] of users.uid']
  Note: 'Firestore path: chatGroups (code+firestore, sampled 4 docs). Group chat rooms (max 20 members).'
}

Table frames {
  frameId varchar [pk, not null, note: 'Document ID']
