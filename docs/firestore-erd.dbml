  sortOrder int [not null]
  createdAt timestamp [not null]
  Note: 'Firestore path: shopItems (code-only, no live docs sampled). Shop catalog (FRAME, SKIN, EFFECT) bought with Astrite. Unique per (itemType, refId).'
}

