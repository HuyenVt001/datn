@startuml seq_quan_ly_goi_nap_1_xem_danh_sach
skinparam style strictuml
skinparam sequenceMessageAlign center
autonumber

actor "Quản trị viên" as U
boundary ":TopupPackagesPage" as UI
control ":topup.api" as API
control ":TopupController" as C
control ":TopupService" as S
entity ":TopupRepository" as R

U -> UI : mở menu Shop, chọn Top-up packages
activate UI
UI -> API : listTopupPackages()
activate API
API -> C : listPackagesAsAdmin()
activate C
C -> S : listAllPackages()
activate S
S -> R : listAllPackages()
activate R
R --> S : TopupPackage[]
deactivate R
S --> C : TopupPackage[]
deactivate S
C --> API : TopupPackage[]
deactivate C
API --> UI : TopupPackage[]
deactivate API
UI --> U : hiển thị danh sách gói nạp
deactivate UI
@enduml
