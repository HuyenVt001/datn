@startuml seq_quan_ly_cua_hang_4_an_hien_vat_pham
skinparam style strictuml
skinparam sequenceMessageAlign center
autonumber

actor "Quản trị viên" as U
boundary ":ShopItemsPage" as UI
control ":shop.api" as API
control ":ShopController" as C
control ":ShopService" as S
entity ":ShopRepository" as R

U -> UI : gạt công tắc mở bán
activate UI
UI -> API : updateShopItem(itemId, {isActive})
activate API
API -> C : updateItem(itemId, dto)
activate C
C -> S : updateItem(itemId, dto)
activate S
S -> R : updateItem(itemId, patch)
activate R
R --> S : Success
deactivate R
S --> C : ShopItem
deactivate S
C --> API : ShopItem
deactivate C
API --> UI : ShopItem
deactivate API
UI --> U : cập nhật trạng thái hiển thị trong Shop
deactivate UI
@enduml
