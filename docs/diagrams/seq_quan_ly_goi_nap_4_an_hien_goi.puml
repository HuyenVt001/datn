@startuml seq_quan_ly_goi_nap_4_an_hien_goi
skinparam style strictuml
skinparam sequenceMessageAlign center
autonumber

actor "Quản trị viên" as U
boundary ":TopupPackagesPage" as UI
control ":topup.api" as API
control ":TopupController" as C
control ":TopupService" as S
entity ":TopupRepository" as R

U -> UI : gạt công tắc hiển thị
activate UI
UI -> API : updateTopupPackage(packageId, {isActive})
activate API
API -> C : updatePackage(packageId, dto)
activate C
C -> S : updatePackage(packageId, dto)
activate S
S -> R : updatePackage(packageId, patch)
activate R
R --> S : Success
deactivate R
S --> C : TopupPackage
deactivate S
C --> API : TopupPackage
deactivate C
API --> UI : TopupPackage
deactivate API
UI --> U : cập nhật trạng thái hiển thị gói trong app
deactivate UI
@enduml
