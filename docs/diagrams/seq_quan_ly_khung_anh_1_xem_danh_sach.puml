@startuml seq_quan_ly_khung_anh_1_xem_danh_sach
skinparam style strictuml
skinparam sequenceMessageAlign center
autonumber

actor "Quản trị viên" as U
boundary ":FramesPage" as UI
control ":frames.api" as API
control ":FramesController" as C
control ":FramesService" as S
entity ":FramesRepository" as R

U -> UI : mở trang Frames
activate UI
UI -> API : listFrames()
activate API
API -> C : listAsAdmin()
activate C
C -> S : listAll()
activate S
S -> R : list()
activate R
R --> S : Frame[]
deactivate R
S --> C : Frame[]
deactivate S
C --> API : Frame[]
deactivate C
API --> UI : Frame[]
deactivate API
UI --> U : hiển thị danh sách khung ảnh
deactivate UI
@enduml
