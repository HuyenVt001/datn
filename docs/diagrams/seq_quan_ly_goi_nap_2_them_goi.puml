@startuml seq_quan_ly_goi_nap_2_them_goi
skinparam style strictuml
skinparam sequenceMessageAlign center
autonumber

actor "Quản trị viên" as U
boundary ":TopupPackagesPage" as UI
control ":topup.api" as API
control ":TopupController" as C
control ":TopupService" as S
entity ":TopupRepository" as R

U -> UI : nhấn Add package
activate UI
UI --> U : hiển thị popup Add package
U -> UI : nhập tên gói, số Astrite, giá VND, nhấn Add
alt Dữ liệu hợp lệ
UI -> API : createTopupPackage(body)
activate API
API -> C : createPackage(dto)
activate C
C -> S : createPackage(dto)
activate S
S -> R : createPackage(pkg)
activate R
R --> S : TopupPackage
deactivate R
S --> C : TopupPackage
deactivate S
C --> API : TopupPackage
deactivate C
API --> UI : TopupPackage
deactivate API
UI --> U : hiển thị gói mới trong danh sách
else Dữ liệu không hợp lệ
UI --> U : báo lỗi trên form
end
deactivate UI
@enduml
