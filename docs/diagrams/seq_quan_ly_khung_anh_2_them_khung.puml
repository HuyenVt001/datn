@startuml seq_quan_ly_khung_anh_2_them_khung
skinparam style strictuml
skinparam sequenceMessageAlign center
autonumber

actor "Quản trị viên" as U
boundary ":FramesPage" as UI
control ":frames.api" as API
control ":FramesController" as C
control ":FramesService" as S
entity ":FramesRepository" as R

U -> UI : nhấn Add frame
activate UI
UI --> U : hiển thị popup Add frame
U -> UI : nhập tên, chọn điều kiện mở khóa, tải ảnh PNG, nhấn Add
alt Dữ liệu hợp lệ
UI -> API : createFrame(body)
activate API
API -> C : create(dto)
activate C
C -> S : create(dto)
activate S
S -> R : create(frame)
activate R
R --> S : Frame
deactivate R
S --> C : Frame
deactivate S
C --> API : Frame
deactivate C
API --> UI : Frame
deactivate API
UI --> U : hiển thị khung mới trong danh sách
else Thiếu tên hoặc ảnh
UI --> U : báo lỗi trên form
end
deactivate UI
@enduml
