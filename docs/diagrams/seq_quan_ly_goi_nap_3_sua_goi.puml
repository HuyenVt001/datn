@startuml seq_quan_ly_goi_nap_3_sua_goi
skinparam style strictuml
skinparam sequenceMessageAlign center
autonumber

actor "Quản trị viên" as U
boundary ":TopupPackagesPage" as UI
control ":topup.api" as API
control ":TopupController" as C
control ":TopupService" as S
entity ":TopupRepository" as R

U -> UI : nhấn Edit
activate UI
UI --> U : hiển thị popup Edit
U -> UI : đổi tên, số Astrite, giá hoặc thứ tự, nhấn Save
UI -> API : updateTopupPackage(packageId, body)
activate API
API -> C : updatePackage(packageId, dto)
activate C
C -> S : updatePackage(packageId, dto)
activate S
S -> R : updatePackage(packageId, patch)
activate R
R --> S : Success
deactivate R
S --> C : TopupPackage
deactivate S
C --> API : TopupPackage
deactivate C
API --> UI : TopupPackage
deactivate API
UI --> U : cập nhật gói trong danh sách
deactivate UI
@enduml
