@startuml seq_quan_ly_khung_anh_5_xem_nguoi_so_huu
skinparam style strictuml
skinparam sequenceMessageAlign center
autonumber

actor "Quản trị viên" as U
boundary ":FramesPage" as UI
control ":frames.api" as API
control ":FramesController" as C
control ":FramesService" as S
entity ":UsersRepository" as R

U -> UI : nhấn icon Who owns this?
activate UI
UI -> API : listFrameOwners(frameId)
activate API
API -> C : listOwners(frameId)
activate C
C -> S : listOwners(frameId)
activate S
S -> R : listByUnlockedFrame(frameId)
activate R
R --> S : User[]
deactivate R
S --> C : {frame, owners}
deactivate S
C --> API : {frame, owners}
deactivate C
API --> UI : {frame, owners}
deactivate API
UI --> U : hiển thị danh sách người sở hữu
deactivate UI
@enduml
