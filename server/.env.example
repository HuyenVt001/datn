# ==== App ====
PORT=3000
NODE_ENV=development
# CORS: domain admin React (Vite), phan cach bang dau phay
CORS_ORIGINS=http://localhost:5173

# ==== Firebase Admin ====
# Duong dan toi service account key (tai tu Firebase Console > Service accounts)
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# ==== JWT (luong admin) ====
JWT_SECRET=doi-thanh-chuoi-bi-mat-dai-ngau-nhien
JWT_EXPIRES_IN=1d

# ==== Cloudinary (upload media) ====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
