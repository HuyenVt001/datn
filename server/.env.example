# ==== App ====
PORT=3000
NODE_ENV=development
# Origin cua admin web (Vite dev server); nhieu origin cach nhau boi dau phay
CORS_ORIGINS=http://localhost:5173

# ==== Firebase Admin ====
# DUONG DAN toi file JSON service account key (KHONG phai email!).
# Tai: Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json
FIREBASE_PROJECT_ID=

# ==== JWT (luong admin) ====
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ==== Cloudinary (upload media) ====
# Lay o https://console.cloudinary.com > Dashboard (Cloud name phai KHOP voi API key/secret)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==== PayOS (nap Astrite — TIEN THAT, production) ====
# Lay o https://my.payos.vn > kenh thanh toan "Snapget" > Thong tin xac thuc.
# ⚠️ BA KHOA DUOI DAY LA BI MAT: khong commit, khong dan vao chat, khong log.
#    File .env da nam trong .gitignore — chi dien o may minh va o bien moi truong
#    cua Render khi deploy.
# ⚠️ KHONG bam nut "lam moi" (refresh) canh nut copy cua Checksum Key: doi khoa
#    se lam moi webhook dang chay bi sai chu ky.
# De TRONG ca 3 khoa => luong nap tat, server van chay binh thuong (cac phan
# khac khong bi anh huong); goi POST /topup/orders se tra 503.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# URL PayOS chuyen huong trinh duyet ve sau khi thanh toan xong / bam huy.
# Phai la domain server DA DEPLOY (PayOS khong goi duoc localhost).
# ⚠️ NHO tien to /api — server dat global prefix trong main.ts.
PAYOS_RETURN_URL=https://datn-8810.onrender.com/api/topup/return
PAYOS_CANCEL_URL=https://datn-8810.onrender.com/api/topup/cancel
