# ==== App ====
PORT=3000
NODE_ENV=development
# Origin cua admin web (Vite dev server); nhieu origin cach nhau boi dau phay
CORS_ORIGINS=http://localhost:5173

# ==== Firebase Admin ====
# DUONG DAN toi file JSON service account key (KHONG phai email!).
# Tai: Firebase Console > Project settings > Service accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT=firebase-service-account.json
FIREBASE_PROJECT_ID=

# ==== JWT (luong admin) ====
JWT_SECRET=
JWT_EXPIRES_IN=1d

# ==== Cloudinary (upload media) ====
# Lay o https://console.cloudinary.com > Dashboard (Cloud name phai KHOP voi API key/secret)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
