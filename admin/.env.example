# URL API cua server NestJS (kem prefix /api)
VITE_API_BASE_URL=http://localhost:3000/api

# Config Firebase Web — lay o Firebase Console > Project settings > General > Your apps.
# Tam thoi co the dung api key/app id tu google-services.json cua app Android;
# neu dang nhap loi "API key not valid" thi tao rieng 1 Web App trong console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=snapget-d8693.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=snapget-d8693
VITE_FIREBASE_APP_ID=
